  {
   "type": "timeseries",
   "title": "Network throughput",
   "description": "Real host interfaces. node-exporter runs with host networking; on the Docker bridge it reported only its own container eth0, so actual WiFi traffic was invisible.",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "h": 8,
    "w": 24,
    "x": 0,
    "y": 21
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "editorMode": "code",
     "range": true,
     "refId": "A",
     "expr": "rate(node_network_receive_bytes_total{device!~\"lo|veth.*|br-.*|docker.*\"}[2m]) * 8",
     "legendFormat": "{{device}} down"
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "editorMode": "code",
     "range": true,
     "refId": "B",
     "expr": "-rate(node_network_transmit_bytes_total{device!~\"lo|veth.*|br-.*|docker.*\"}[2m]) * 8",
     "legendFormat": "{{device}} up"
    }
   ],
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom",
     "showLegend": true
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   },
   "fieldConfig": {
    "defaults": {
     "unit": "bps",
     "custom": {
      "drawStyle": "line",
      "lineWidth": 1,
      "fillOpacity": 8,
      "showPoints": "never",
      "spanNulls": true,
      "axisCenteredZero": true
     },
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       }
      ]
     }
    },
