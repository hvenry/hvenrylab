# cp .env.example .env, then fill in. Gitignored: holds tokens and passwords.
# Compose syntax, not shell: # starts a comment mid-line, $ a variable.

# --- Host identity ---------------------------------------------------------
# Must own data/ and the media tree, or containers write files nothing else can read.  id -u / id -g
PUID=1001
PGID=1001
TZ=America/Toronto

# --- Storage ---------------------------------------------------------------
# The library: read-only in Jellyfin, read-write in Radarr/Sonarr/Bazarr (they rename files).
MEDIA_DIR=/srv/media/library

# --- Ingress ---------------------------------------------------------------
# Public names are <service>.${DOMAIN}; the Caddyfile hardcodes hvenry.com too.
DOMAIN=hvenry.com
# Tailscale IP Caddy binds; this bind is what keeps services tailnet-only.  tailscale ip -4
TS_IP=
# Cloudflare token for ACME DNS-01: Zone:DNS:Edit on this one zone only.
CLOUDFLARE_API_TOKEN=

# --- Monitoring -------------------------------------------------------------
GRAFANA_USER=admin
# Required: Compose refuses to start Grafana without it.
GRAFANA_PASSWORD=change-me

# --- Dashboard widgets ------------------------------------------------------
# Optional; an empty key just breaks that widget. *arr keys: Settings -> General,
# or grep -oP '(?<=<ApiKey>)[^<]+' data/<app>/config.xml
RADARR_API_KEY=
SONARR_API_KEY=
BAZARR_API_KEY=
# Unused until Homepage supports Jellyfin 12's header-only auth (docs/dashboard.md).
JELLYFIN_API_KEY=

# --- ntfy -------------------------------------------------------------------
# The topic IS the credential: anyone who knows it can read and publish.
#   echo "homelab-$(openssl rand -hex 8)"
NTFY_TOPIC=change-me

# --- AI ---------------------------------------------------------------------
# Empty = qwen2.5:7b / nomic-embed-text. Not a 3B chat model: see docs/ai.md.
CLEARRAG_CHAT_MODEL=
CLEARRAG_EMBED_MODEL=

# --- ootd -------------------------------------------------------------------
# Locally built tag (docs/ootd.md); roll back by restoring the previous value.
OOTD_TAG=0.1.0
#   openssl rand -hex 24
OOTD_DB_PASSWORD=change-me
# Checkout ootd-dev serves and ootd-worker mounts its code from. Empty = /home/hvenry/dev/ootd.
OOTD_SRC=
